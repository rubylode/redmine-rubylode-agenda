<%# Only the fields Redmine lets this person change on this ticket now; the rest are left out. %>
<%= form_tag project_rubylode_agenda_line_issue_path(@project, @line), method: :post,
             class: "rubylode-agenda-ticket-form rubylode-agenda-change-form",
             data: { request_method: "PATCH", action: "submit->rubylode-agenda#submitPanelForm keydown->rubylode-agenda#ticketFormKey" } do %>
  <p class="rubylode-agenda-form-errors" role="alert" hidden></p>
  <p class="rubylode-agenda-ticket-heading rubylode-agenda-ticket-field-wide">
    <%= link_to "##{@issue.id} #{@issue.subject}", issue_path(@issue), class: "rubylode-agenda-ticket-open" %>
  </p>
  <% if @fields.include?("status_id") %>
    <label class="rubylode-agenda-ticket-field">
      <%= l("field_status") %>
      <%= select_tag :status_id, options_from_collection_for_select(@issue.new_statuses_allowed_to(User.current), :id, :name, @issue.status_id),
                     class: "rubylode-agenda-ticket-input", data: { autofocus: true } %>
    </label>
  <% end %>
  <% if @fields.include?("assigned_to_id") %>
    <label class="rubylode-agenda-ticket-field">
      <%= l("field_assigned_to") %>
      <%= select_tag :assigned_to_id, options_from_collection_for_select(@issue.assignable_users, :id, :name, @issue.assigned_to_id),
                     include_blank: l("rubylode_agenda.tickets.nobody"), class: "rubylode-agenda-ticket-input" %>
    </label>
  <% end %>
  <% if @fields.include?("priority_id") %>
    <label class="rubylode-agenda-ticket-field">
      <%= l("field_priority") %>
      <%= select_tag :priority_id, options_from_collection_for_select(IssuePriority.active, :id, :name, @issue.priority_id),
                     class: "rubylode-agenda-ticket-input" %>
    </label>
  <% end %>
  <% if @fields.include?("fixed_version_id") %>
    <label class="rubylode-agenda-ticket-field">
      <%= l("field_fixed_version") %>
      <%= select_tag :fixed_version_id, options_from_collection_for_select(@issue.assignable_versions, :id, :name, @issue.fixed_version_id),
                     include_blank: l("rubylode_agenda.tickets.no_version"), class: "rubylode-agenda-ticket-input" %>
    </label>
  <% end %>
  <% if @fields.include?("due_date") %>
    <label class="rubylode-agenda-ticket-field">
      <%= l("field_due_date") %>
      <%= date_field_tag :due_date, @issue.due_date, class: "rubylode-agenda-ticket-input" %>
    </label>
  <% end %>
  <% if @fields.include?("done_ratio") %>
    <label class="rubylode-agenda-ticket-field">
      <%= l("field_done_ratio") %>
      <%= select_tag :done_ratio, options_for_select((0..10).map { |step| ["#{step * 10} %", step * 10] }, @issue.done_ratio),
                     class: "rubylode-agenda-ticket-input" %>
    </label>
  <% end %>
  <% if @issue.notes_addable?(User.current) %>
    <label class="rubylode-agenda-ticket-field rubylode-agenda-ticket-field-wide">
      <%= l("rubylode_agenda.tickets.change_note") %>
      <%= text_area_tag :notes, "", rows: 2, class: "rubylode-agenda-ticket-input" %>
    </label>
  <% end %>
  <span class="rubylode-agenda-ticket-actions">
    <%= submit_tag l("rubylode_agenda.tickets.save_change"), class: "rubylode-agenda-button" %>
    <button type="button" class="rubylode-agenda-button" data-action="click->rubylode-agenda#closeTicketForm">
      <%= l("rubylode_agenda.tickets.cancel") %>
    </button>
  </span>
<% end %>
