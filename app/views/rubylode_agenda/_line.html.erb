<% ticket = line.visible_issue(User.current) %>
<% shown_depth = local_assigns[:shown_depth] || line.shown_depth %>
<li class="rubylode-agenda-line rubylode-agenda-depth-<%= shown_depth %><%= " rubylode-agenda-line-done" if line.done %><%= " rubylode-agenda-line-closed" if ticket&.closed? %>"
    data-line-id="<%= line.id %>" data-topic-id="<%= line.topic_id %>" data-position="<%= line.position %>"
    data-depth="<%= line.depth %>" data-lock-version="<%= line.lock_version %>" data-quiet="<%= line.quiet? %>"
    <% if ticket %>data-ticket-path="<%= project_rubylode_agenda_line_issue_path(project, line) %>" data-issue-path="<%= issue_path(ticket) %>"<% end %>
    <% if editable %>data-update-path="<%= project_rubylode_agenda_line_path(project, line) %>" data-park-path="<%= park_project_rubylode_agenda_line_path(project, line) %>"<% end %>
    <% if editable && line.issue_id.nil? && User.current.allowed_to?(:add_issues, project) %>data-new-ticket-path="<%= new_project_rubylode_agenda_line_issue_path(project, line) %>"<% end %>>
  <% if editable %>
    <span class="rubylode-agenda-handle" draggable="true" data-field="line-handle" title="<%= l("rubylode_agenda.line.drag") %>">⋮⋮</span>
  <% end %>
  <input type="checkbox" class="rubylode-agenda-line-checkbox" data-field="line-done" <%= "checked" if line.done %>
         <%= "disabled" unless editable %> aria-label="<%= l("rubylode_agenda.line.done_label") %>">
  <% if ticket %>
    <%= render partial: "rubylode_agenda/ticket_badge", locals: { ticket: ticket, expandable: true } %>
  <% end %>
  <% if editable %>
    <textarea class="rubylode-agenda-line-text" rows="1" data-field="line-text" data-original="<%= line.text %>"
              maxlength="<%= RubylodeAgenda::Line::MAXIMUM_TEXT_LENGTH %>" aria-label="<%= l("rubylode_agenda.line.text_label") %>"
              data-action="keydown->rubylode-agenda#lineTicketKey"><%= line.text %></textarea>
    <%= render partial: "rubylode_agenda/carried_label", locals: { line: line } %>
    <button type="button" class="rubylode-agenda-menu-button" data-action="click->rubylode-agenda#openMenuFromButton"
            aria-haspopup="menu" title="<%= l("rubylode_agenda.menu.open") %>" aria-label="<%= l("rubylode_agenda.menu.open") %>">&#8943;</button>
  <% else %>
    <span class="rubylode-agenda-line-text"><%= line.text %></span>
    <%= render partial: "rubylode_agenda/carried_label", locals: { line: line } %>
  <% end %>
  <div class="rubylode-agenda-line-detail" data-role="ticket-detail"></div>
  <div class="rubylode-agenda-line-detail" data-role="ticket-form"></div>
</li>
