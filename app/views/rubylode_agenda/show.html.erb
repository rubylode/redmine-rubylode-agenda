<% content_for :header_tags do %>
  <%= stylesheet_link_tag "rubylode_agenda", plugin: "redmine_rubylode_agenda" %>
  <%= javascript_include_tag "rubylode_agenda", plugin: "redmine_rubylode_agenda", type: "module" %>
<% end %>

<div class="rubylode-agenda" data-controller="rubylode-agenda"
     data-rubylode-agenda-conflict-message-value="<%= l("rubylode_agenda.messages.conflict") %>"
     data-rubylode-agenda-failure-message-value="<%= l("rubylode_agenda.messages.failure") %>"
     data-rubylode-agenda-blank-message-value="<%= l("rubylode_agenda.messages.blank") %>"
     data-rubylode-agenda-changes-url-value="<%= changes_project_rubylode_agenda_agenda_path(@project, @agenda) if @agenda %>"
     data-rubylode-agenda-agenda-id-value="<%= @agenda&.id.to_i %>"
     data-rubylode-agenda-revision-value="<%= @agenda&.revision.to_i %>"
     data-rubylode-agenda-agenda-closed-value="<%= @agenda ? !@agenda.open? : false %>"
     data-rubylode-agenda-conflict-theirs-value="<%= l("rubylode_agenda.conflict.theirs") %>"
     data-rubylode-agenda-conflict-keep-mine-value="<%= l("rubylode_agenda.conflict.keep_mine") %>"
     data-rubylode-agenda-conflict-take-theirs-value="<%= l("rubylode_agenda.conflict.take_theirs") %>"
     data-action="change->rubylode-agenda#change keydown->rubylode-agenda#keydown click->rubylode-agenda#click dragstart->rubylode-agenda#dragStart dragover->rubylode-agenda#dragOver drop->rubylode-agenda#drop dragend->rubylode-agenda#dragEnd input->rubylode-agenda#input contextmenu->rubylode-agenda#contextMenu"
     data-rubylode-agenda-count-format-value="<%= l("rubylode_agenda.rail.count_both", active: "%{active}", quiet: "%{quiet}") %>">
  <% if @agenda.nil? %><h2><%= l("rubylode_agenda.page.title") %></h2><% end %>
  <%= render "rubylode_agenda/header", project: @project, agenda: @agenda, agendas: @agendas, editable: @editable, may_make_tickets: @may_make_tickets %>
  <p class="rubylode-agenda-status" role="status" aria-live="polite" hidden data-rubylode-agenda-target="status"></p>
  <p class="rubylode-agenda-notice" role="status" hidden data-rubylode-agenda-target="notice"><%= l("rubylode_agenda.conflict.agenda_closed") %></p>
  <p class="rubylode-agenda-notice" role="status" hidden data-rubylode-agenda-target="broughtBack"><a href="" data-rubylode-agenda-target="broughtBackLink"><%= l("rubylode_agenda.parked.brought_back") %></a></p>
  <p class="rubylode-agenda-notice rubylode-agenda-created-notice" role="status" hidden data-rubylode-agenda-target="createdNotice"></p>

  <% if @agenda.nil? %>
    <% if @editable %>
      <p class="nodata"><%= l("rubylode_agenda.page.no_agendas") %></p>
      <%= button_to l("rubylode_agenda.agenda.start_first"), project_rubylode_agenda_agendas_path(@project), method: :post, class: "rubylode-agenda-button rubylode-agenda-button-primary", data: { disable_with: l("rubylode_agenda.agenda.start_first") } %>
    <% else %>
      <p class="nodata"><%= l("rubylode_agenda.page.no_agendas_reader") %></p>
    <% end %>
  <% else %>
    <div class="rubylode-agenda-columns">
      <%= render "rubylode_agenda/rail", project: @project, topics: @topics, setting: @setting, editable: @editable %>
      <section class="rubylode-agenda-main">
        <ol class="rubylode-agenda-topics" data-rubylode-agenda-target="topics"
            data-reorder-path="<%= reorder_project_rubylode_agenda_agenda_topics_path(@project, @agenda) %>">
          <% @topics.each do |topic| %>
            <%= render partial: "rubylode_agenda/topic", locals: { topic: topic, project: @project, editable: @editable } %>
          <% end %>
        </ol>
        <% if @editable %>
          <div class="rubylode-agenda-new-topic">
            <input type="text" class="rubylode-agenda-topic-title" data-field="topic-new"
                   data-create-path="<%= project_rubylode_agenda_agenda_topics_path(@project, @agenda) %>"
                   placeholder="<%= l("rubylode_agenda.topic.title_placeholder") %>"
                   aria-label="<%= l("rubylode_agenda.topic.title_placeholder") %>">
          </div>
        <% end %>
        <%= render "rubylode_agenda/parked", project: @project, editable: @editable %>
      </section>
      <%= render "rubylode_agenda/sidebar", project: @project, agenda: @agenda %>
    </div>
  <% end %>
  <% if @editable %>
    <%# One menu for every row; the script fills in which entries apply to the row it opens for. %>
    <div class="rubylode-agenda-menu" role="menu" hidden data-rubylode-agenda-target="menu"
         aria-label="<%= l("rubylode_agenda.menu.label") %>" data-topic-confirm="<%= l("rubylode_agenda.topic.confirm_delete") %>">
      <% [["make-ticket", "line", "make_ticket", "shortcut_make_ticket"], ["make-child-ticket", "line", "make_child_ticket", nil],
          ["link-ticket", "line", "link_ticket", nil], ["open-ticket", "line", "open_ticket", nil],
          ["show-ticket", "line", "show_ticket", nil], ["change-ticket", "line", "change_ticket", nil],
          ["make-child-of", "line", "make_child_of", nil], ["make-parent-of", "line", "make_parent_of", nil],
          ["remove-parent", "line", "remove_parent", nil], ["unlink-ticket", "line", "unlink_ticket", nil],
          ["select-for-tickets", "line", "select_for_tickets", nil], ["topic-tickets", "topic", "topic_tickets", nil],
          ["indent", "line", "indent", "shortcut_indent"],
          ["outdent", "line", "outdent", "shortcut_outdent"], ["move-up", "any", "move_up", nil],
          ["move-down", "any", "move_down", nil], ["park", "line", "park", "shortcut_park"],
          ["delete", "any", "delete", nil]].each do |action, rows, label, shortcut| %>
        <button type="button" role="menuitem" tabindex="-1" class="rubylode-agenda-menu-entry"
                data-menu-action="<%= action %>" data-menu-rows="<%= rows %>">
          <span class="rubylode-agenda-menu-label"><%= l("rubylode_agenda.menu.#{label}") %></span>
          <% if shortcut %><kbd class="rubylode-agenda-menu-shortcut"><%= l("rubylode_agenda.menu.#{shortcut}") %></kbd><% end %>
        </button>
      <% end %>
    </div>
  <% end %>
  <% if @may_make_tickets %>
    <%# Making several tickets: the bar pinned to the bottom while lines are selected, and the review in a dialog. %>
    <div class="rubylode-agenda-selection-bar" role="region" aria-label="<%= l("rubylode_agenda.bulk.selection_label") %>" hidden
         data-rubylode-agenda-target="selectionBar"
         data-review-path="<%= review_project_rubylode_agenda_agenda_tickets_path(@project, @agenda) %>"
         data-selected-text="<%= l("rubylode_agenda.bulk.selected", count: "%{count}") %>"
         data-select-label="<%= l("rubylode_agenda.bulk.select_label") %>"
         data-select-topic-label="<%= l("rubylode_agenda.bulk.select_topic") %>"
         data-limit="<%= RubylodeAgenda::BulkTickets::LIMIT %>">
      <span class="rubylode-agenda-selection-count" aria-live="polite" data-rubylode-agenda-target="selectionCount"></span>
      <span class="rubylode-agenda-selection-limit" hidden data-rubylode-agenda-target="selectionLimit"><%= l("rubylode_agenda.bulk.over_limit", limit: RubylodeAgenda::BulkTickets::LIMIT) %></span>
      <span class="rubylode-agenda-selection-actions">
        <button type="button" class="rubylode-agenda-button rubylode-agenda-button-primary" data-rubylode-agenda-target="reviewButton"
                data-action="click->rubylode-agenda#reviewSelection"><%= l("rubylode_agenda.bulk.review_create") %></button>
        <button type="button" class="rubylode-agenda-button" data-action="click->rubylode-agenda#stopSelecting"><%= l("rubylode_agenda.tickets.cancel") %></button>
      </span>
    </div>
    <dialog class="rubylode-agenda-review-dialog" aria-labelledby="rubylode-agenda-review-heading" data-rubylode-agenda-target="reviewDialog"></dialog>
  <% end %>
</div>
