<%# A small line of the number over the recent meetings, scaled to its own lowest and highest value, with a dot on the
    last point. Drawn only from two values on; a gap breaks the line. No title element: the label says it all. %>
<% values = points.map(&:value) %>
<% if values.compact.size >= 2 %>
  <% width = 64.0; height = 20.0; pad = 2.0 %>
  <% low, high = values.compact.minmax.map(&:to_f) %>
  <% step = (width - 2 * pad) / (points.size - 1) %>
  <% place = lambda do |index, value|
       y = high == low ? height / 2 : pad + (high - value.to_f) / (high - low) * (height - 2 * pad)
       [pad + index * step, y]
     end %>
  <% runs = points.each_with_index.chunk_while { |(first, _), (second, _)| !first.value.nil? && !second.value.nil? }
                 .map { |run| run.reject { |point, _| point.value.nil? } }.reject(&:empty?) %>
  <% shown = ->(value) { key == "average_days_to_close" ? format("%.1f", value) : value.to_s } %>
  <% label = points.map { |point| point.value.nil? ? l("rubylode_agenda.numbers.sparkline_gap", date: format_date(point.date)) : l("rubylode_agenda.numbers.sparkline_point", date: format_date(point.date), value: shown.call(point.value)) } %>
  <% last_index = points.rindex { |point| !point.value.nil? } %>
  <svg class="rubylode-agenda-sparkline" role="img" width="64" height="20" viewBox="0 0 64 20"
       aria-label="<%= l("rubylode_agenda.numbers.sparkline", measure: l("rubylode_agenda.numbers.#{key}"), values: label.join(", ")) %>">
    <% runs.each do |run| %>
      <% if run.size > 1 %>
        <polyline points="<%= run.map { |point, index| place.call(index, point.value).map { |coordinate| format("%.1f", coordinate) }.join(",") }.join(" ") %>" />
      <% elsif run.first.last != last_index %>
        <% x, y = place.call(run.first.last, run.first.first.value) %>
        <circle class="rubylode-agenda-sparkline-lone" cx="<%= format("%.1f", x) %>" cy="<%= format("%.1f", y) %>" r="1" />
      <% end %>
    <% end %>
    <% x, y = place.call(last_index, points[last_index].value) %>
    <circle class="rubylode-agenda-sparkline-last" cx="<%= format("%.1f", x) %>" cy="<%= format("%.1f", y) %>" r="2" />
  </svg>
<% end %>
