<%# Each number a tile: the number, its label, and on a line of its own how it moved since the previous agenda. The words
    say up or down; the colour only repeats it. For these two numbers a smaller value is the better one. %>
<% shown = ->(key, number) { key == "average_days_to_close" ? format("%.1f", number) : number.to_s } %>
<% history = report.history %>
<% links = report.list_links %>
<% live_note = report.agenda.open? ? "" : l("rubylode_agenda.numbers.link_live") %>
<section class="rubylode-agenda-sidebar-section rubylode-agenda-numbers">
  <div class="rubylode-agenda-number-tiles">
    <% %w[closed opened still_open average_days_to_close overdue].each do |key| %>
      <% value = report.numbers[key] %>
      <% previous = report.previous_numbers[key] if %w[average_days_to_close overdue].include?(key) %>
      <%# Five tiles in two columns: the last one spans both, and its sparkline takes the room. %>
      <% wide = key == "overdue" %>
      <%# The whole tile is a link to Redmine's list of its tickets, when that list can be built; its name is the tile's
          own text (number, measure, how it moved, the sparkline's label) and then "show the tickets". %>
      <% list = links.params_for(key) %>
      <% tag_name = list ? "a" : "p" %>
      <<%= tag_name %> class="rubylode-agenda-number<%= " rubylode-agenda-number-wide" if wide %><%= " rubylode-agenda-number-link" if list %>" data-kpi="<%= key %>"<% if list %> href="<%= project_issues_path(report.project, list) %>"<% end %>>
        <span class="rubylode-agenda-number-value"><%= value.nil? ? "-" : shown.call(key, value) %></span>
        <span class="rubylode-agenda-number-label"><%= l("rubylode_agenda.numbers.#{key}") %></span>
        <% unless previous.nil? %>
          <% direction = value.nil? ? "was" : (value > previous ? "up" : (value < previous ? "down" : "same")) %>
          <span class="rubylode-agenda-number-before rubylode-agenda-number-<%= direction %>">
            <%= l("rubylode_agenda.numbers.#{direction}_from") %>
            <span class="rubylode-agenda-number-previous"><%= shown.call(key, previous) %></span>
          </span>
        <% end %>
        <%= render "rubylode_agenda/sidebar/sparkline", points: history.points(key), key: key, width: wide ? 140 : 64 %>
        <% if list %><span class="rubylode-agenda-visually-hidden">, <%= l("rubylode_agenda.numbers.link_suffix") %><%= live_note %></span><% end %>
      </<%= tag_name %>>
    <% end %>
  </div>
</section>
<%= render "rubylode_agenda/sidebar/breakdown", report: report, links: links %>
<% if report.show_closed_per_person? %>
  <%# Shown only where the project chose it, and not as a ranking: by name, the unassigned last, no bars. %>
  <% people = report.closed_per_person.sort_by { |row| [row["user_id"] ? 0 : 1, row["name"].to_s.downcase] } %>
  <section class="rubylode-agenda-sidebar-section rubylode-agenda-closed-per-person">
    <h4><%= l("rubylode_agenda.numbers.closed_per_person") %></h4>
    <% if people.empty? %>
      <p class="nodata"><%= l("rubylode_agenda.numbers.nobody_closed") %></p>
    <% else %>
      <ul class="rubylode-agenda-people">
        <% people.each do |row| %>
          <li class="rubylode-agenda-person">
            <% person_list = links.person_params(row["user_id"]) %>
            <% person_name = row["name"] || l("rubylode_agenda.sidebar.unassigned") %>
            <% if person_list %>
              <%= link_to person_name, project_issues_path(report.project, person_list), class: "rubylode-agenda-person-name" %>
            <% else %>
              <span class="rubylode-agenda-person-name"><%= person_name %></span>
            <% end %>
            <span class="rubylode-agenda-person-count"><%= row["count"] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
